{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Pi-hole v6 DNS + DHCP metrics from prometheus_pihole_exporter. Multi-instance via the `instance` template variable.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "tags": [],
      "targetBlank": true,
      "title": "Exporter source",
      "tooltip": "github.com/reloaded/prometheus_pihole_exporter",
      "type": "link",
      "url": "https://github.com/reloaded/prometheus_pihole_exporter"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Status",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 2,
      "title": "Up",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 3, "x": 0, "y": 1},
      "targets": [{"expr": "pihole_up{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3,
      "title": "Queries today",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 3, "y": 1},
      "targets": [{"expr": "pihole_dns_queries_total{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue"}]}}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4,
      "title": "Blocked today",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 7, "y": 1},
      "targets": [{"expr": "pihole_dns_queries_blocked_total{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}]}}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 5,
      "title": "Block ratio",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 4, "x": 11, "y": 1},
      "targets": [{"expr": "pihole_dns_queries_blocked_ratio{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}, {"color": "green", "value": 0.05}, {"color": "yellow", "value": 0.3}, {"color": "red", "value": 0.6}]}}},
      "options": {"showThresholdLabels": false, "showThresholdMarkers": true}
    },
    {
      "id": 6,
      "title": "Active clients",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 3, "x": 15, "y": 1},
      "targets": [{"expr": "pihole_dns_clients_active{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 7,
      "title": "Gravity domains",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 3, "x": 18, "y": 1},
      "targets": [{"expr": "pihole_gravity_domains{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 8,
      "title": "Blocking",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 3, "x": 21, "y": 1},
      "targets": [{"expr": "pihole_blocking_enabled{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {"0": {"text": "OFF", "color": "red"}, "1": {"text": "ON", "color": "green"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 10,
      "title": "DNS",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "panels": []
    },
    {
      "id": 11,
      "title": "Query rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"expr": "rate(pihole_dns_queries_total{instance=~\"$instance\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{instance}} total"},
        {"expr": "rate(pihole_dns_queries_blocked_total{instance=~\"$instance\"}[$__rate_interval])", "refId": "B", "legendFormat": "{{instance}} blocked"},
        {"expr": "rate(pihole_dns_queries_forwarded_total{instance=~\"$instance\"}[$__rate_interval])", "refId": "C", "legendFormat": "{{instance}} forwarded"},
        {"expr": "rate(pihole_dns_queries_cached_total{instance=~\"$instance\"}[$__rate_interval])", "refId": "D", "legendFormat": "{{instance}} cached"}
      ],
      "fieldConfig": {"defaults": {"unit": "qps", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "stacking": {"mode": "none"}}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 12,
      "title": "Queries by type",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [{"expr": "rate(pihole_dns_queries_by_type_total{instance=~\"$instance\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{type}}"}],
      "fieldConfig": {"defaults": {"unit": "qps", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 30, "stacking": {"mode": "normal"}}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 13,
      "title": "Queries by reply",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [{"expr": "rate(pihole_dns_queries_by_reply_total{instance=~\"$instance\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{reply}}"}],
      "fieldConfig": {"defaults": {"unit": "qps", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 30, "stacking": {"mode": "normal"}}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 14,
      "title": "Queries by status",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [{"expr": "rate(pihole_dns_queries_by_status_total{instance=~\"$instance\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "qps", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 30, "stacking": {"mode": "normal"}}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 20,
      "title": "Upstreams",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "panels": []
    },
    {
      "id": 21,
      "title": "Upstream query rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "targets": [{"expr": "rate(pihole_dns_upstream_queries_total{instance=~\"$instance\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{upstream}}"}],
      "fieldConfig": {"defaults": {"unit": "qps", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 22,
      "title": "Upstream response time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "targets": [{"expr": "pihole_dns_upstream_response_seconds{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{upstream}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 30,
      "title": "FTL runtime",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31},
      "panels": []
    },
    {
      "id": 31,
      "title": "FTL CPU %",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 32},
      "targets": [{"expr": "pihole_ftl_cpu_percent{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10}}}
    },
    {
      "id": 32,
      "title": "FTL memory %",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 32},
      "targets": [{"expr": "pihole_ftl_memory_percent{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10}}}
    },
    {
      "id": 33,
      "title": "Scrape duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 32},
      "targets": [{"expr": "pihole_scrape_duration_seconds{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10}}}
    },
    {
      "id": 40,
      "title": "DHCP",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 39},
      "panels": []
    },
    {
      "id": 41,
      "title": "Active DHCP leases",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 40},
      "targets": [{"expr": "sum by (family) (pihole_dhcp_leases_active{instance=~\"$instance\"})", "refId": "A", "legendFormat": "{{family}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 42,
      "title": "Expired (still on file)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 40},
      "targets": [{"expr": "sum by (family) (pihole_dhcp_leases_expired{instance=~\"$instance\"})", "refId": "A", "legendFormat": "{{family}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}, {"color": "yellow", "value": 5}]}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 43,
      "title": "DHCP message rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 40},
      "targets": [{"expr": "rate(pihole_dhcp_messages_total{instance=~\"$instance\"}[$__rate_interval])", "refId": "A", "legendFormat": "{{type}}"}],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 44,
      "title": "Time since last DHCP event",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 47},
      "targets": [{"expr": "time() - pihole_dhcp_log_last_event_timestamp_seconds{instance=~\"$instance\"} > 0", "refId": "A", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 3600}, {"color": "red", "value": 86400}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 45,
      "title": "DHCP leases by family",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 47},
      "targets": [
        {"expr": "pihole_dhcp_leases_active{instance=~\"$instance\"}", "refId": "A", "legendFormat": "active", "format": "table", "instant": true},
        {"expr": "pihole_dhcp_leases_expired{instance=~\"$instance\"}", "refId": "B", "legendFormat": "expired", "format": "table", "instant": true},
        {"expr": "pihole_dhcp_leases_total{instance=~\"$instance\"}", "refId": "C", "legendFormat": "total", "format": "table", "instant": true}
      ],
      "transformations": [
        {"id": "merge"},
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "service": true, "namespace": true}, "renameByName": {"Value #A": "active", "Value #B": "expired", "Value #C": "total"}}}
      ]
    },
    {
      "id": 50,
      "title": "Health",
      "type": "row",
      "collapsed": true,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 54},
      "panels": [
        {
          "id": 51,
          "title": "Per-collector health",
          "type": "stat",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "gridPos": {"h": 5, "w": 24, "x": 0, "y": 55},
          "targets": [{"expr": "pihole_collector_up{instance=~\"$instance\"}", "refId": "A", "legendFormat": "{{instance}} / {{collector}}"}],
          "fieldConfig": {
            "defaults": {
              "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
              "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
            }
          },
          "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
        },
        {
          "id": 52,
          "title": "Pi-hole component versions",
          "type": "table",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "gridPos": {"h": 5, "w": 24, "x": 0, "y": 60},
          "targets": [{"expr": "pihole_info{instance=~\"$instance\"}", "refId": "A", "format": "table", "instant": true}],
          "transformations": [
            {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "Value": true}}}
          ]
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["pihole", "dns", "dhcp"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"}
      },
      {
        "name": "instance",
        "label": "Pi-hole instance",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": {"qryType": 1, "query": "label_values(pihole_up, instance)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "regex": "",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"selected": false, "text": "All", "value": "$__all"}
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "Pi-hole — DNS + DHCP",
  "uid": "prometheus-pihole-exporter",
  "version": 1,
  "weekStart": ""
}
